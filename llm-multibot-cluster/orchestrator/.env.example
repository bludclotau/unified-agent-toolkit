# Copy to /etc/discord-bots/orchestrator.env (mode 640, group discordbots).
# Per-bot tokens stay in /etc/discord-bots/<name>.env and are never stored here.

CONFIG_DIR=/etc/discord-bots
LLM_URL=http://10.1.1.122:8081/v1/chat/completions
LLM_MODEL=qwen2.5-7b-instruct-q4_k_m
DATABASE_URL=postgresql://llm_agents:change-me@127.0.0.1:5432/agent_cluster

API_HOST=127.0.0.1
API_PORT=8787
API_TOKEN=replace-me

GGUF_ROUTER_URL=http://127.0.0.1:9000
KEYHOLE_URL=http://127.0.0.1:8080
LETTA_URL=http://127.0.0.1:8283
INTEGRATIONS_DIR=/home/wendy/waffle_house/integrations

DECAY_FACTOR=0.55
DECAY_HALF_LIFE_MS=180000
MIN_ENERGY=0.18
AMBIENT_RATE=0.35
MAX_BOT_CHAIN=3
REPLY_GAP_MIN_MS=1800
REPLY_GAP_MAX_MS=4200
LLM_TIMEOUT_MS=90000
LLM_MAX_TOKENS=256
